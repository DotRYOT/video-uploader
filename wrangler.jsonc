{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "video-uploader",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "vars": {
    "PUBLIC_ORIGIN": "https://video.ryot.cc"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/v/*", "/media/*", "/poster/*"]
  },
  "r2_buckets": [
    {
      "binding": "VIDEOS_BUCKET",
      "bucket_name": "video-server"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VIDEO_REGISTRY",
        "class_name": "VideoRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VideoRegistry"]
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}